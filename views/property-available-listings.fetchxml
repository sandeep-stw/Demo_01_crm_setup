<?xml version="1.0" encoding="utf-8"?>
<fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false">
  <entity name="cre_property">
    <attribute name="cre_name" />
    <attribute name="cre_market" />
    <attribute name="cre_submarket" />
    <attribute name="cre_buildingsf" />
    <attribute name="cre_leasingstatus" />
    <attribute name="cre_leaserate" />
    <order attribute="cre_market" descending="false" />
    <filter type="and">
      <condition attribute="statecode" operator="eq" value="0" />
      <condition attribute="cre_leasingstatus" operator="eq" value="851250000" />
    </filter>
  </entity>
</fetch>
