<?xml version="1.0" encoding="utf-8"?>
<fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false">
  <entity name="contact">
    <attribute name="fullname" />
    <attribute name="emailaddress1" />
    <attribute name="cre_minsf" />
    <attribute name="cre_maxsf" />
    <attribute name="cre_targetmarkets" />
    <attribute name="cre_propertypreferences" />
    <attribute name="cre_relationshiptier" />
    <order attribute="cre_minsf" descending="false" />
    <filter type="and">
      <condition attribute="statecode" operator="eq" value="0" />
      <condition attribute="cre_minsf" operator="not-null" />
      <condition attribute="cre_maxsf" operator="not-null" />
    </filter>
  </entity>
</fetch>
