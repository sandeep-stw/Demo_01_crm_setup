        "type": "Money"
      },
      {
        "schemaName": "cre_commissionmethod",
        "displayName": "Commission Calculation Method",
        "type": "Picklist",
        "optionSet": "cre_commissionmethod"
      },
      {
        "schemaName": "cre_referralfees",
        "displayName": "Referral Fees",
        "type": "Money"
